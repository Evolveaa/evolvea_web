# Supabase — publishable values only; nothing here is a secret.
# All privileged operations run through Postgres RLS, never through a service key in the app.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Speech assessment (Edge Function secrets — NOT app env) ─────────────────
# These are NOT read by the Next.js app. They are secrets for the `assess-speech`
# Edge Function only, and must be set with the Supabase CLI so they never touch
# the browser bundle:
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set EVOLVEA_STT_API_KEY=sk-...          # OpenAI (default) or Deepgram key
#
# Optional overrides (defaults shown):
#   supabase secrets set EVOLVEA_LLM_MODEL=claude-opus-4-8   # the LLM that judges the transcript
#   supabase secrets set EVOLVEA_STT_PROVIDER=openai         # openai | deepgram
#   supabase secrets set EVOLVEA_STT_MODEL=gpt-4o-transcribe # provider-specific model id
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into Edge Functions
# automatically by Supabase — do not set them here.
